<Page x:Name="page_home" x:Class="VMGuide.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:VMGuide"
      mc:Ignorable="d"
      Background="{DynamicResource MaterialDesignPaper}"
      d:DesignHeight="500" d:DesignWidth="750"
      Title="VMGuide"
      Loaded="HomePage_Loaded">

    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="SectionTitle" BasedOn="{StaticResource MaterialDesignHeadline6TextBlock}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="ListBox" x:Key="FlatListBox" BasedOn="{StaticResource MaterialDesignListBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="VirtualMachine" Width="20" Height="20" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <materialDesign:Card Padding="16" Margin="0,0,0,16" Grid.Row="0">
            <DockPanel>
                <Image Source="Resources/logo.png" Width="64" Height="64" Stretch="Uniform" Margin="0,0,16,0"/>
                <StackPanel>
                    <TextBlock Text="Welcome" Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
                    <TextBlock Text="Select a virtual machine to continue." Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <materialDesign:Card x:Name="grid_unattendMode" Padding="12" Visibility="{Binding ElementName=page_home,Path=IsUnattendMode.Value,Converter={StaticResource BooleanToCollapseConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CloudDownload" Margin="0,0,12,0"/>
                        <TextBlock x:Name="ImportPrompt" VerticalAlignment="Center"/>
                        <Button x:Name="ImportCancel"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="16,0,0,0"
                                Content="Cancel"
                                Click="ImportCancel_Click"/>
                    </StackPanel>
                </materialDesign:Card>

                <UniformGrid Columns="1" Rows="3" ColumnsMinWidth="280" ColumnsMaxWidth="500">
                    <materialDesign:Card x:Name="grid_vpc" Padding="16" Margin="0,0,0,8"
                                         Visibility="{Binding ElementName=listbox_vpc,Path=HasItems,Converter={StaticResource BooleanToCollapseConverter}}">
                        <StackPanel>
                            <TextBlock Text="Virtual PC" Style="{StaticResource SectionTitle}"/>
                            <ListBox x:Name="listbox_vpc" Style="{StaticResource FlatListBox}" SelectionChanged="VMLists_SelectionChanged"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card x:Name="grid_vmx" Padding="16" Margin="0,0,0,8"
                                         Visibility="{Binding ElementName=listbox_vmx,Path=HasItems,Converter={StaticResource BooleanToCollapseConverter}}">
                        <StackPanel>
                            <TextBlock Text="VMware" Style="{StaticResource SectionTitle}"/>
                            <ListBox x:Name="listbox_vmx" Style="{StaticResource FlatListBox}" SelectionChanged="VMLists_SelectionChanged"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card x:Name="grid_vbox" Padding="16" Margin="0,0,0,8"
                                         Visibility="{Binding ElementName=listbox_vbox,Path=HasItems,Converter={StaticResource BooleanToCollapseConverter}}">
                        <StackPanel>
                            <TextBlock Text="VirtualBox" Style="{StaticResource SectionTitle}"/>
                            <ListBox x:Name="listbox_vbox" Style="{StaticResource FlatListBox}" SelectionChanged="VMLists_SelectionChanged"/>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,16,0,0">
            <Button Content="Open VM file"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    CommandParameter="Open"
                    Click="Button_Click"
                    materialDesign:RippleAssist.IsCentered="True"
                    HorizontalAlignment="Left"/>

            <materialDesign:PopupBox x:Name="settingsPopup" PlacementMode="BottomAndAlignRight"
                                     StaysOpen="False">
                <StackPanel>
                    <Button Content="Refresh" Style="{StaticResource MaterialDesignFlatButton}" Click="RefreshMenuClicked"/>
                    <Button Content="About" Style="{StaticResource MaterialDesignFlatButton}" Click="AboutMenuClicked"/>
                </StackPanel>
            </materialDesign:PopupBox>
        </DockPanel>
    </Grid>
</Page>
