<Page x:Name="page_main" x:Class="VMGuide.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:VMGuide"
      mc:Ignorable="d"
      Background="{DynamicResource MaterialDesignPaper}"
      d:DesignHeight="500" d:DesignWidth="750"
      Loaded="MainPage_Loaded"
      Title="{Binding ElementName=title,Path=Text}">
    <Page.Resources>
        <local:VMwareValueToDescriptionConverter x:Key="VMwareValueToDescriptionConverter"/>
        <Style TargetType="ComboBox" x:Key="ComboBoxStyle" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="Width" Value="272"/>
        </Style>
        <Style TargetType="ListBox" x:Key="NicListBoxStyle" BasedOn="{StaticResource MaterialDesignListBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <StackPanel IsItemsHost="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Margin="8,4" Background="{DynamicResource MaterialDesignCardBackground}">
                            <TextBlock Text="{Binding Converter={StaticResource VMwareValueToDescriptionConverter}}"
                                       Style="{StaticResource MaterialDesignBody1TextBlock}" Margin="8,8,8,4"/>
                            <StackPanel Orientation="Horizontal" Margin="8,0,8,8"
                                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource BooleanToCollapseConverter}}">
                                <ComboBox Text="{Binding}"
                                          Width="220"
                                          Margin="0,0,8,0"
                                          ItemsSource="{Binding VMwareNicList, ElementName=page_main}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          SelectionChanged="ComboBox_SelectionChanged"/>
                                <Button Width="36" Height="36" Click="DeleteNIC_Button_Click"
                                        Style="{StaticResource MaterialDesignIconButton}">
                                    <materialDesign:PackIcon Kind="Delete" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,12">
            <DockPanel VerticalAlignment="Center">
                <Button Content="Back" Style="{StaticResource MaterialDesignFlatButton}" Click="BackButton_Click"/>
                <TextBlock x:Name="title" Text="{Binding CurrentVM.Name}" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
        </materialDesign:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions >
                <ColumnDefinition Width="220"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}" Margin="0,0,12,0" Spacing="4">
                <RadioButton x:Name="radio_bios" VerticalAlignment="Top" IsChecked="True" Content="BIOS Settings"
                             Style="{StaticResource MaterialDesignRadioButton}" />
                <RadioButton x:Name="radio_hw"  VerticalAlignment="Top" Content="Hardware Settings"
                             Visibility="{Binding IsVMware, Converter={StaticResource BooleanToCollapseConverter}}"
                             Style="{StaticResource MaterialDesignRadioButton}"/>
            </StackPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Foreground="#cc211e" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding CurrentVM.IsLocked,Converter={StaticResource BooleanToCollapseConverter }}"
                               Text="This Virtual Machine is Locked by your hypervisor, exit your hypervisor and try again."/>

                    <StackPanel Margin="0,0,0,24"
                                    Visibility="{Binding ElementName=radio_bios,Path=IsChecked,Converter={StaticResource BooleanToCollapseConverter }}"
                                    IsEnabled="{Binding CurrentVM.IsLocked,Converter={StaticResource BooleanReverseConverter}}">
                        <TextBlock Text="BIOS Settings" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                        <CheckBox x:Name="check_biosdate" Content="BIOS Date Lock" Style="{StaticResource MaterialDesignCheckBox}"
                                  Checked="CheckBox_biosdate_Checked" Unchecked="CheckBox_biosdate_Unchecked"/>
                        <DatePicker VerticalContentAlignment="Center"  x:Name="datepicker"
                                    IsEnabled="{Binding ElementName=check_biosdate, Path=IsChecked}"
                                        Visibility="{Binding ElementName=check_biosdate ,Path=IsChecked,Converter={StaticResource BooleanToCollapseConverter}}"
                                        Uid="BIOS Date" Style="{StaticResource MaterialDesignDatePicker }">
                        </DatePicker>
                        <CheckBox Content="ACPI Enabled" IsChecked="{Binding CurrentVirtualMachineWithACPI.ACPI}" Style="{StaticResource MaterialDesignCheckBox}"
                                  Visibility="{Binding IsVirtualMachineWithACPI,Converter={StaticResource BooleanToCollapseConverter}}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24"
                                    Visibility="{Binding ElementName=radio_hw,Path=IsChecked,Converter={StaticResource BooleanToCollapseConverter }}"
                                    IsEnabled="{Binding CurrentVM.IsLocked,Converter={StaticResource BooleanReverseConverter}}">
                        <TextBlock Text="Hardware Settings" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>

                        <materialDesign:Card Padding="12" Margin="0,8,0,8">
                            <StackPanel>
                                <TextBlock Text="Firmware" Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                <ComboBox x:Name="combo_fw" Margin="0,8,0,0" Text="{Binding CurrentVMwareVM.Firmware}" HorizontalAlignment="Left"
                                          ItemsSource="{Binding VMwareFirmwareList}" Style="{StaticResource ComboBoxStyle}"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Sound Card" Style="{StaticResource MaterialDesignBody1TextBlock}"/>
                                <ComboBox x:Name="combo_snd" Margin="0,8,0,0" Text="{Binding CurrentVMwareVM.SoundCard}" HorizontalAlignment="Left"
                                          ItemsSource="{Binding VMwareSoundCardList}" Style="{StaticResource ComboBoxStyle}"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <StackPanel Visibility="{Binding IsVMware,Converter={StaticResource BooleanToCollapseConverter}}">
                            <TextBlock Text="Network Adapters" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,8,0,8"/>
                            <ListBox x:Name="list_nic" Margin="-10,0,0,0" Style="{StaticResource NicListBoxStyle}" ItemsSource="{Binding CurrentVMwareNICs}"/>
                            <Button Content="Add a Network Adapter" Cursor="Hand" Margin="0,10,0,0 " Click="AddNIC_Button_Click" Style="{StaticResource MaterialDesignFlatButton}"/>
                        </StackPanel>


                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
